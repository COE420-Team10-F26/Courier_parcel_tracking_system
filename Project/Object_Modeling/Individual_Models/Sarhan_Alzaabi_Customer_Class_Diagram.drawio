roundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c34"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="16" as="offset"/></mxGeometry></mxCell><mxCell id="c36" value="0..*" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c34"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="c37" value="is delivered to ▶" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;endArrow=open;endSize=10;startArrow=diamondThin;startFill=1;startSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c37"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="c39" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c37"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="c40" value="&amp;laquo;use&amp;raquo;" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;endArrow=open;endSize=10;dashed=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="Abstract: never created directly. Customer, Administrator and FieldStaff inherit all of these. Login works for all three roles (UC-02); isTempPassword forces Change Temporary Password (UC-11); 4 failed logins lock the account for 15 minutes via lockedUntil (NFR-09)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=12;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="840" y="70" width="240" height="95" as="geometry"/></mxCell><mxCell id="c42" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="c41" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="trackingNumber is unique, format CPT-XXXXXX (6 digits), created on booking confirmation (FR-04 / UC-04).&lt;br&gt;&lt;br&gt;getDeliveryWindowHours(): 24 if recipient.emirate = senderEmirate, otherwise 48, counted from pickedUpAt (FR-03)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=12;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="300" height="85" as="geometry"/></mxCell><mxCell id="c44" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="c43" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="Booking is rejected if a field is empty, weightKg is not &amp;gt; 0 and &amp;le; 70, or any dimension is not &amp;gt; 0 and &amp;le; 150 cm (FR-03)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=12;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="590" y="560" width="250" height="58" as="geometry"/></mxCell><mxCell id="c46" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="c45" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="isValidPhone(): UAE number, +971 followed by 9 digits (FR-03)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=12;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="720" width="190" height="50" as="geometry"/></mxCell><mxCell id="c48" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="c47" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>