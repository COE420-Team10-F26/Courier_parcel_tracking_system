tryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k114" target="k146"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="860"/><mxPoint x="1375" y="860"/></Array></mxGeometry></mxCell><mxCell id="k202" value="0..1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k201"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="16" as="offset"/></mxGeometry></mxCell><mxCell id="k203" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k201"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k204" value="is sent to ▶" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="k102" target="k106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k205" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k204"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k206" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k204"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k207" value="is about ▶" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.06;entryDx=0;entryDy=0;" edge="1" parent="1" source="k110" target="k138"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="145" y="620"/><mxPoint x="530" y="620"/><mxPoint x="530" y="918"/></Array></mxGeometry></mxCell><mxCell id="k208" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k207"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="6" y="16" as="offset"/></mxGeometry></mxCell><mxCell id="k209" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k207"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k210" value="records change of ▶" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="k130" target="k138"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k211" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k210"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k212" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k210"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k213" value="made by ▶" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;exitX=0;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="k130" target="k106"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="8" y="960"/><mxPoint x="8" y="340"/><mxPoint x="1200" y="340"/><mxPoint x="1200" y="269"/></Array></mxGeometry></mxCell><mxCell id="k214" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k213"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-40" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k215" value="0..1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k213"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k216" value="alerts on ▶" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="k134" target="k138"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k217" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k216"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="8" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k218" value="1" style="edgeLabel;resizable=0;html=1;align=right;verticalAlign=bottom;fontSize=11;fontStyle=1;labelBackgroundColor=none;" vertex="1" connectable="0" parent="k216"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="-8" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="k219" value="«use»" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="k138" target="k162"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k220" value="Abstract: never created directly. Customer, Administrator and FieldStaff inherit all of these. Login works for all three roles (UC-02); isTempPassword forces Change Temporary Password (UC-11); 4 failed logins lock the account for 15 minutes via lockedUntil (NFR-09)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1730" y="70" width="260" height="100" as="geometry"/></mxCell><mxCell id="k221" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="k220" target="k106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k222" value="Abstract: StatusNotification and AssignmentNotification inherit from it. Delivery is retried for up to 24 hours (retryUntil); a failed notification never blocks status-history logging. StatusNotification goes to the customer; AssignmentNotification goes to the field staff member." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="260" height="92" as="geometry"/></mxCell><mxCell id="k223" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="k222" target="k102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k224" value="Only customers and field staff can be deactivated (FR-07). Deactivating sets isActive = false: the user cannot log in but records are kept. New staff/admin accounts get a temporary password (isTempPassword = true). reassignParcel() is only allowed before pickup." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1800" y="282" width="310" height="90" as="geometry"/></mxCell><mxCell id="k225" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="k224" target="k122"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k226" value="Booking is rejected if a field is empty, weightKg is not &gt; 0 and ≤ 70, any dimension is not &gt; 0 and ≤ 150 cm, or the phone is not +971 followed by 9 digits (FR-03)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="870" y="650" width="280" height="62" as="geometry"/></mxCell><mxCell id="k227" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="k226" target="k118"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k228" value="trackingNumber is unique, format CPT-XXXXXX, created on booking confirmation (FR-04). getDeliveryWindowHours(): 24 if the recipient's emirate = senderEmirate, otherwise 48, counted from pickedUpAt (FR-03)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="1380" width="290" height="80" as="geometry"/></mxCell><mxCell id="k229" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;entryX=0.05;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k228" target="k138"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k230" value="Only Pending Pickup parcels can be assigned. confirmAssignment() sets every parcel to Assigned and sends one summary notification. A parcel is in at most one current assignment; reassigning moves it before pickup, and an assignment whose last parcel is reassigned is removed." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1300" y="1160" width="290" height="92" as="geometry"/></mxCell><mxCell id="k231" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="k230" target="k146"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k232" value="Set manually by an admin for each field staff member (one emirate each); never assigned automatically." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1700" y="1140" width="260" height="48" as="geometry"/></mxCell><mxCell id="k233" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="k232" target="k150"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k234" value="Max 3 attempts per parcel; after the 3rd failed attempt the parcel becomes RETURNED_TO_SENDER (FR-13)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2100" y="1125" width="300" height="48" as="geometry"/></mxCell><mxCell id="k235" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="k234" target="k154"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="k236" value="Delayed = undelivered with no status change for 48 hours (FR-20). Alerts are kept with the parcel in D2; resolve() marks one resolved at the next real status update. Setting DELAYED does not reset lastStatusChangeAt." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;spacingRight=10;fontSize=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="250" y="1240" width="300" height="62" as="geometry"/></mxCell><mxCell id="k237" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;edgeStyle=none;" edge="1" parent="1" source="k236" target="k134"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>