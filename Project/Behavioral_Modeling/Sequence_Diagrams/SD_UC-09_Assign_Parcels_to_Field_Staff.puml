@startuml
title UC-09 Assign Parcels to Field Staff (Kevin Alex, b00098368)
skinparam sequenceMessageAlign left
skinparam style strictuml

actor Admin
participant ":Administrator" as A
participant ":Parcel" as P
participant ":Assignment" as As
participant ":StatusHistoryEntry" as H
participant ":DelayAlert" as D
participant ":StatusNotification" as SN
participant ":AssignmentNotification" as N

Admin -> A : viewAllParcels()
activate A
A --> Admin : List<Parcel>

Admin -> A : getUnassignedParcels()
A --> Admin : List<Parcel>

Admin -> A : ~*[for each staff] getStaffWorkload(staff)
A --> Admin : workload : int

Admin -> A : [staff active] assignParcels(parcels, staff)

create As
A -> As : <<create>> Assignment
activate As

A -> As : ~*[for each parcel p] addParcel(p)

A -> As : validateParcels()
As --> A : valid : boolean

alt valid = true
A -> As : confirmAssignment()

As -> P : ~*[for each parcel p] updateStatus(ASSIGNED)
activate P

' ---- SHARED BLOCK (same steps in UC-03, UC-09 and UC-16) ----
create H
P -> H : <<create>> StatusHistoryEntry

P -> D : [active delay alert] resolve()
activate D
D --> P
deactivate D

create SN
P -> SN : <<create>> StatusNotification
P -> SN : buildMessage()
activate SN
SN --> P : message : String
P -> SN : send()
SN --> P : sent : boolean
deactivate SN
' ---- END SHARED BLOCK ----

P --> As
deactivate P

As -> As : getParcelCount()
As --> As : count : int
As -> As : getAssignedStaff()
As --> As : staff : FieldStaff

create N
As -> N : <<create>> AssignmentNotification(count, staff)
As -> N : buildSummary()
activate N
N --> As : summary : String
deactivate N
As -> N : send()
activate N
N --> As : sent : boolean
deactivate N

As --> A
A --> Admin : Assignment
else else
A --> Admin : invalid parcels, assignment not confirmed
end
deactivate As
deactivate A
@enduml