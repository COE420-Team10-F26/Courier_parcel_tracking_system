      <mxCell id="t09title" value="UC-09 Assign Parcels to Field Staff (Kevin Alex, b00098368)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="100" width="1180" height="36" as="geometry" /></mxCell><mxCell id="t09note" value="send() hands the notification to the notification queue and returns at once; failures are retried for up to 24 h (NFR-18) and never block status-history logging (NFR-19) or the rest of the workflow." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=14;spacingTop=2;fontSize=11;" vertex="1" parent="X7GI3sgepbDjkfEGPn9F-29"><mxGeometry x="15" y="250" width="255" height="80" as="geometry" /></mxCell><mxCell id="t09link" style="endArrow=none;dashed=1;html=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t09note" target="X7GI3sgepbDjkfEGPn9F-57"><mxGeometry relative="1" as="geometry" /></mxCell></root>
