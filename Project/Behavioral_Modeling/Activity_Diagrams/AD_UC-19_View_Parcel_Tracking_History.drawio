keWidth=1.3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n113" target="n114"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n136" value="Read-only lookup (P5 rule 7): no status is set and no status history entry is recorded, so there is no status change, no delay-alert check and no Notification lane. Nothing in this workflow is genuinely parallel, so there is no fork or join." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=16;spacingTop=4;fontSize=12;" vertex="1" parent="laneC"><mxGeometry x="25.0" y="520.0" width="330" height="110" as="geometry"/></mxCell><mxCell id="n137" value="getStatusHistory() returns the entries in chronological order (by changedAt), as in the Lab 6 sequence diagram." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingRight=16;spacingTop=4;fontSize=12;" vertex="1" parent="laneS"><mxGeometry x="25.0" y="500.0" width="200" height="80" as="geometry"/></mxCell><mxCell id="n138" style="edgeStyle=none;rounded=0;html=1;endArrow=none;dashed=1;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n137" target="n107"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>